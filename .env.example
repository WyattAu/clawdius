# Clawdius Environment Variables
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit this file with real API keys.

# ─── LLM Provider Keys ──────────────────────────────────
# Uncomment and fill in the provider(s) you want to use.

# Anthropic (Claude)
#ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (GPT-4, etc.)
#OPENAI_API_KEY=sk-...

# OpenRouter (multi-provider proxy)
#OPENROUTER_API_KEY=sk-or-...

# ZAI (infinite balance, use conservatively)
#ZAI_API_KEY=...

# Ollama (local models)
#OLLAMA_BASE_URL=http://localhost:11434

# ─── Default Model Settings ──────────────────────────────
CLAWDIUS_DEFAULT_PROVIDER=anthropic
CLAWDIUS_DEFAULT_MODEL=claude-sonnet-4-20250514

# ─── Storage Backend ────────────────────────────────────
# Options: sqlite, postgres, mariadb
CLAWDIUS_STORAGE=sqlite

# PostgreSQL (if CLAWDIUS_STORAGE=postgres)
POSTGRES_PASSWORD=clawdius-dev

# ─── Platform Bot Tokens ────────────────────────────────
# Uncomment the platforms you want to connect.

# Telegram (create via @BotFather)
#TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Discord (create via Discord Developer Portal)
#DISCORD_BOT_TOKEN=...

# Slack (create via api.slack.com/apps)
#SLACK_BOT_TOKEN=xoxb-...
#SLACK_APP_TOKEN=xapp-...

# Matrix (create bot account on your homeserver)
#MATRIX_HOMESERVER_URL=https://matrix.org
#MATRIX_ACCESS_TOKEN=syt_...

# Signal (requires signal-cli running)
#SIGNAL_ACCOUNT_NUMBER=+1234567890
#SIGNAL_REST_URL=http://localhost:7583

# Microsoft Teams (Azure Bot Framework)
#TEAMS_APP_ID=...
#TEAMS_APP_PASSWORD=...

# WhatsApp Business (Meta Developer Portal)
#WHATSAPP_ACCESS_TOKEN=...
#WHATSAPP_PHONE_NUMBER_ID=...
#WHATSAPP_VERIFY_TOKEN=...

# Rocket.Chat
#ROCKETCHAT_SERVER_URL=https://your-rocketchat.example.com
#ROCKETCHAT_TOKEN=...
#ROCKETCHAT_USER_ID=...

# Generic Webhook
#WEBHOOK_URL=https://your-server.example.com/webhook
#WEBHOOK_SECRET=...

# ─── Rate Limiting ─────────────────────────────────────
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW=60

# ─── Logging ────────────────────────────────────────────
RUST_LOG=info
# RUST_LOG=debug  # For verbose logging
# RUST_LOG=clawdius_gateway=debug,clawdius_core=trace  # Per-crate

# ─── Project Mount ─────────────────────────────────────
# Path to your project root (mounted into CLI container)
PROJECT_ROOT=.
